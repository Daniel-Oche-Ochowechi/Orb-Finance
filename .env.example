# ==============================================================================
# Orb Finance Environment Configuration
# ==============================================================================

# Supabase Project URL and Public Anon Key (Found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (Required for Admin Dashboard & Secure Server Operations)
# NEVER expose this key on the client side.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Security Key / Passcode (Used to log in to /admin)
# Default fallback passcode in development is: orb-admin-2027
ADMIN_SECRET_KEY=orb-admin-2027
ADMIN_SESSION_SECRET=orb-super-secure-random-token-secret-2027

# ==============================================================================
# Transactional Email Configuration (Waitlist Confirmations)
# Configure EITHER Resend (Option A) OR Standard SMTP (Option B).
# ==============================================================================

# Option A: Resend API (Recommended — https://resend.com)
# RESEND_API_KEY=re_your_api_key_here

# Option B: Standard SMTP (Gmail App Password, Zoho, Namecheap, Brevo, AWS SES, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=hello@orbfinance.com
# SMTP_PASS=your_app_password_here

# Sender & Reply-To Addresses
# For Resend testing without a verified domain, use: Orb Finance <onboarding@resend.dev>
# For Gmail SMTP, set EMAIL_FROM to match your SMTP_USER address.
EMAIL_FROM=Orb Finance <hello@orbfinance.com>
EMAIL_REPLY_TO=hello@orbfinance.com
